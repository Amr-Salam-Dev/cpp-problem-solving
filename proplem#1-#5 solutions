// solution 5 hire a driver case 2

struct stInfo
{
	int Age;
	bool hasdriverlicensse;
	bool hasrecommendation;
};
stInfo ReadInfo()
{
	stInfo Info;
	cout << "Please enter Your Age : " << endl;
	cin >> Info.Age;
	cout << "Do you have driver License ? (1 for Yes, 0 for No): " << endl;
	cin >> Info.hasdriverlicensse;
	cout << "Do you have recommendation ? (1 for Yes, 0 for No): " << endl;
	cin >> Info.hasrecommendation;
	return Info;
}
bool IsAccepted(stInfo Info)
{
	if (Info.hasrecommendation)
	{
		return true;
	}
	else
	{
		return (Info.Age > 21 && Info.hasdriverlicensse);
	}

}
void PrintResult(stInfo Info)
{
	if (IsAccepted(Info))
		cout << "\n Accepted \n";
	else
		cout << "\n Not Accepted \n";
}
int main() {
	PrintResult(ReadInfo());
	return 0;
}

